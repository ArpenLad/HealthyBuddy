{
  "expo": {
    "name": "HealthyBuddy",
    "slug": "healthybuddy",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "healthybuddy",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/hb-logo.png",
          "color": "#E86F51"
        }
      ],
      "expo-font"
    ],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/hb-logo.png",
        "backgroundColor": "#F7F6F2"
      },
      "package": "com.healthybuddy.app"
    }
  }
}
